{
  "name": "qrllib-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "PATH=\"$HOME/.cargo/bin:/opt/homebrew/opt/rustup/bin:$PATH\" wasm-pack build ../crates/qrllib-wasm --target web --out-dir pkg",
    "build:app": "vite build",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && npm run build:app",
    "typecheck:app": "tsc --noEmit",
    "typecheck": "npm run build:wasm && npm run typecheck:app",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
